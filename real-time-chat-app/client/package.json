    "@babel/runtime": "^8.0.7",
    "bootstrap": "^5.3.8",
    "graphql": "^17.0.2",
    "graphql-sse": "^2.6.3",
    "graphql-ws": "^6.4.1",
    "react": "^19.3.1",
    "react-bootstrap": "^2.10.10",
    "react-dom": "^19.3.1",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@babel/core": "^8.0.7",
    "@babel/preset-env": "^8.0.7",
    "@babel/preset-react": "^8.0.1",
    "babel-loader": "^10.1.1",
    "css-loader": "^7.1.5",
    "html-webpack-plugin": "^5.6.8",
    "style-loader": "^4.0.0",
    "webpack": "^5.112.2",
    "webpack-cli": "^7.2.3",
    "webpack-dev-server": "^6.1.0"
  }
